# ---------------------------------------------------------------------------
# Repository-wide ignores for the task-manager project.
# Flutter/Dart specific rules also live in task_manager/.gitignore.
# ---------------------------------------------------------------------------

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE / editor
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.code-workspace

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Machine-specific SDK locations (never commit these)
**/android/local.properties
**/android/key.properties
**/android/*.jks
**/android/*.keystore
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts
**/android/app/debug
**/android/app/profile
**/android/app/release

# Environment / secrets
.env
.env.*
!.env.example
